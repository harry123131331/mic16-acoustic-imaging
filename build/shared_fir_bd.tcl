   CONFIG.FIFO_MODE {1} \
   CONFIG.HAS_TKEEP {1} \
   CONFIG.TDATA_NUM_BYTES {4} \
 ] $axis_data_fifo_0

  # Create instance: clk_wiz_0, and set properties
  set clk_wiz_0 [ create_bd_cell -type ip -vlnv xilinx.com:ip:clk_wiz:6.0 clk_wiz_0 ]
  set_property -dict [ list \
   CONFIG.PRIM_IN_FREQ {100.000} \
 ] $clk_wiz_0

  # Create instance: d4f_hp1, and set properties
  set d4f_hp1 [ create_bd_cell -type ip -vlnv xilinx.com:ip:axi_interconnect:2.1 d4f_hp1 ]
  set_property -dict [ list \
   CONFIG.NUM_MI {1} \
   CONFIG.NUM_SI {1} \
 ] $d4f_hp1

  # Create instance: d4f_hp2, and set properties
  set d4f_hp2 [ create_bd_cell -type ip -vlnv xilinx.com:ip:axi_interconnect:2.1 d4f_hp2 ]
  set_property -dict [ list \
   CONFIG.NUM_MI {1} \
   CONFIG.NUM_SI {1} \
 ] $d4f_hp2

  # Create instance: d4f_irq, and set properties
  set d4f_irq [ create_bd_cell -type ip -vlnv xilinx.com:ip:xlconcat:2.1 d4f_irq ]
  set_property -dict [ list \
   CONFIG.NUM_PORTS {4} \
 ] $d4f_irq

  # Create instance: d4f_tf_front_q24, and set properties
  set d4f_tf_front_q24 [ create_bd_cell -type ip -vlnv mic16:acoustic:m16_sp_shared:2.0 d4f_tf_front_q24 ]

  # Create instance: d4f_tf_zone_q2_24, and set properties
  set d4f_tf_zone_q2_24 [ create_bd_cell -type ip -vlnv xilinx.com:hls:mic16_tf_zone_streaming_hls_q2_24:1.0 d4f_tf_zone_q2_24 ]

  # Create instance: pl_pdm_top_16_0, and set properties
  set block_name pl_pdm_top_16
  set block_cell_name pl_pdm_top_16_0
  if { [catch {set pl_pdm_top_16_0 [create_bd_cell -type module -reference $block_name $block_cell_name] } errmsg] } {
     catch {common::send_gid_msg -ssname BD::TCL -id 2095 -severity "ERROR" "Unable to add referenced block <$block_name>. Please add the files for ${block_name}'s definition into the project."}
     return 1
   } elseif { $pl_pdm_top_16_0 eq "" } {
     catch {common::send_gid_msg -ssname BD::TCL -id 2096 -severity "ERROR" "Unable to referenced block <$block_name>. Please add the files for ${block_name}'s definition into the project."}
     return 1
   }
    set_property -dict [ list \
   CONFIG.SAMPLES_PER_PACKET {2048} \
   CONFIG.SHARED_DECIMATOR {1} \
 ] $pl_pdm_top_16_0

  # Create instance: proc_sys_reset_0, and set properties
  set proc_sys_reset_0 [ create_bd_cell -type ip -vlnv xilinx.com:ip:proc_sys_reset:5.0 proc_sys_reset_0 ]

